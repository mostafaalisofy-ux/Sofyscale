---
interface Props {
  kicker: string;
  headline: string;
  sub?: string;
  /** Number of trailing words set in the editorial accent */
  accent?: number;
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
  align?: 'start' | 'center';
}
const { kicker, headline, sub, accent = 1, as: Tag = 'h2', id, class: cls, align = 'start' } = Astro.props;
const words = headline.split(' ');
const cut = Math.max(0, words.length - accent);
const head = words.slice(0, cut).join(' ');
const tail = words.slice(cut).join(' ');
---

<div class:list={['max-w-4xl', align === 'center' && 'mx-auto text-center', cls]}>
  <p class:list={['kicker', align === 'center' && 'justify-center']} data-reveal>{kicker}</p>
  <Tag id={id} class="h-section mt-5" data-reveal style="--d:1">
    {head && <>{head} </>}<span class="accent">{tail}</span>
  </Tag>
  {sub && <p class:list={['lede mt-6 max-w-2xl', align === 'center' && 'mx-auto']} data-reveal style="--d:2">{sub}</p>}
</div>
