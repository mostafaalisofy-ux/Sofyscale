---
import type { Lang } from '../data/types';
import { type CaseStudy, FILTERS, t } from '../data/cases';

interface Props { item: CaseStudy; lang: Lang; class?: string; eager?: boolean; showFigure?: boolean }
const { item, lang, class: cls, eager = false, showFigure = true } = Astro.props;
const lead = item.metrics[0];
const industryKey = item.industries.find((k) => k !== 'ecommerce' && k !== 'retail') ?? item.industries[0];
const industry = FILTERS.industry.find((f) => f.key === industryKey)!;
---

<div class:list={['zoom relative isolate overflow-hidden bg-ink-3', !item.cover && 'cover-type', cls]}>
  {item.cover ? (
    <>
      <img src={item.cover} alt="" width="830" height="466" loading={eager ? 'eager' : 'lazy'} decoding="async" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
    </>
  ) : (
    showFigure && (
      <p class="display fig absolute inset-x-6 bottom-6 text-[clamp(2.5rem,5vw,3.75rem)] leading-none text-fg/90 tnum" aria-hidden="true">
        <bdi dir="ltr">{t(lead.value, lang)}</bdi>
      </p>
    )
  )}
  <div class="absolute inset-x-5 top-5 flex items-start justify-between gap-3">
    <span class="tag">{t(industry.label, lang)}</span>
    <span class="tag tnum"><bdi dir="ltr">{item.num}</bdi></span>
  </div>
</div>
