---
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/types';
import { getContent, href } from '../../i18n';

interface Props { lang: Lang; path: string; title: string; body: string; kicker?: string }
const { lang, path, title, body, kicker } = Astro.props;
const c = getContent(lang);
---

<Base lang={lang} path={path} title={`${title} · Sofy.`} description={body} noindex>
  <section class="relative isolate grid min-h-[80svh] place-items-center overflow-hidden pt-24">
    <div class="glow left-1/2 top-1/3 -z-10 h-[34rem] w-[34rem] -translate-x-1/2 opacity-60"></div>
    <div class="wrap text-center">
      {kicker && <p class="brand text-[clamp(6rem,20vw,14rem)] leading-none text-violet-soft/80"><bdi dir="ltr">{kicker}</bdi></p>}
      <h1 class="h-section mx-auto mt-6 max-w-3xl">{title}</h1>
      <p class="lede mx-auto mt-6 max-w-xl">{body}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={href(lang, '/')} class="btn btn-primary">{c.ui.home}</a>
        <a href={href(lang, '/case-studies')} class="btn btn-ghost">{c.ctaSecondary}</a>
      </div>
    </div>
  </section>
</Base>
