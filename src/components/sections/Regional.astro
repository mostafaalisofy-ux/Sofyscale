---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const r = c.regional;
const markets = lang === 'ar'
  ? [{ code: 'KSA', name: 'الرياض' }, { code: 'EG', name: 'القاهرة' }]
  : [{ code: 'KSA', name: 'Riyadh' }, { code: 'EG', name: 'Cairo' }];
---

<section id="regional" class="section relative isolate overflow-hidden border-t border-line" aria-labelledby="regional-title">
  <div class="glow start-[-20%] bottom-0 -z-10 h-[34rem] w-[34rem] opacity-40"></div>
  <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <SectionHead num="07" kicker={r.kicker} headline={r.headline} accent={lang === 'ar' ? 3 : 4} id="regional-title" />
      <div class="mt-12 flex items-center gap-5" data-reveal style="--d:2">
        {markets.map((m, i) => (
          <>
            {i > 0 && (
              <span class="relative h-px flex-1 bg-gradient-to-r from-violet-soft/10 via-violet-soft/70 to-violet-soft/10" aria-hidden="true">
                <span class="absolute -top-[3px] start-1/2 h-[7px] w-[7px] rounded-full bg-violet-soft"></span>
              </span>
            )}
            <span class="text-center">
              <span class="brand block text-6xl leading-none sm:text-7xl">{m.code}</span>
              <span class="mt-2 block text-xs uppercase tracking-[0.18em] text-muted">{m.name}</span>
            </span>
          </>
        ))}
      </div>
      <p class="mt-8 text-sm uppercase tracking-[0.18em] text-violet-soft" data-reveal style="--d:3">{r.tagline}</p>
    </div>
    <ol class="lg:col-span-6">
      {r.items.map((item, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 border-t border-line py-7 last:border-b" data-reveal>
          <span class="display text-2xl text-violet-soft tnum"><bdi dir="ltr">{String(i + 1).padStart(2, '0')}</bdi></span>
          <div>
            <h3 class="text-xl font-medium">{item.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
