---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const r = c.results;
const [lead, ...rest] = r.stats.slice().reverse();
---

<section id="results" class="section border-t border-line" aria-labelledby="results-title">
  <div class="wrap">
    <SectionHead num="08" kicker={r.kicker} headline={r.headline} accent={2} id="results-title" />

    <div class="mt-16 grid gap-px overflow-hidden rounded-[1.5rem] border border-line bg-line lg:grid-cols-12">
      <div class="relative isolate overflow-hidden bg-ink p-8 sm:p-12 lg:col-span-6 lg:row-span-2">
        <div class="glow -bottom-32 -end-32 -z-10 h-96 w-96 opacity-80"></div>
        <div data-reveal>
          <p class="text-sm text-fg-2">{lead.label}</p>
          <p>
            <span class="display mt-6 block text-[clamp(4rem,11vw,9rem)] leading-[0.9] tnum"><bdi dir="ltr">{lead.value}</bdi></span>
            {lead.note && <span class="mt-6 block max-w-sm text-sm text-muted">{lead.note}</span>}
          </p>
        </div>
      </div>
      {rest.map((s, i) => (
        <div class="bg-ink p-8 sm:p-10 lg:col-span-3">
          <div data-reveal style={`--d:${i % 2}`}>
            <p class="text-sm text-fg-2">{s.label}</p>
            <p>
              <span class="display mt-4 block text-6xl leading-none tnum sm:text-7xl"><bdi dir="ltr">{s.value}</bdi></span>
              {s.note && <span class="mt-4 block text-xs leading-relaxed text-muted">{s.note}</span>}
            </p>
          </div>
        </div>
      ))}
    </div>

    <ul class="mt-4 grid gap-4 md:grid-cols-3">
      {r.pillars.map((p, i) => (
        <li class="card p-8" data-reveal style={`--d:${i}`}>
          <p class="text-xs uppercase tracking-[0.18em] text-violet-soft">{p.kicker}</p>
          <h3 class="display mt-4 text-3xl leading-tight">{p.title}</h3>
          <p class="mt-3 text-sm text-muted">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="marquee mt-24 overflow-hidden border-y border-line py-8" role="region" aria-label={c.results.kicker}>
    <ul class="marquee-track">
      {[0, 1].map((copy) => (
        <li class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {r.industries.map((ind) => (
            <span class="display flex items-center whitespace-nowrap px-8 text-4xl text-fg-2 sm:text-5xl">
              {ind}
              <span class="ms-16 text-violet-soft" aria-hidden="true">·</span>
            </span>
          ))}
        </li>
      ))}
    </ul>
  </div>
</section>
