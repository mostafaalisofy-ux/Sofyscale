---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import Picture from '../Picture.astro';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const a = c.about;
---

<section id="about" class="section border-t border-line" aria-labelledby="about-title">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <SectionHead num="01" kicker={a.kicker} headline={a.headline} accent={2} id="about-title" />
      <div class="mt-10 grid max-w-2xl gap-6">
        {a.paragraphs.map((p, i) => (
          <p class:list={[i === 0 ? 'text-xl leading-relaxed text-fg sm:text-2xl' : 'lede']} data-reveal style={`--d:${i}`}>{p}</p>
        ))}
      </div>
    </div>
    <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--d:1">
      <div class="relative overflow-hidden rounded-[1.5rem] border border-line bg-ink-3 lg:sticky lg:top-28">
        <Picture
          image="portrait"
          alt={a.portraitAlt}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 24rem, 92vw"
          width={800}
          height={1000}
          class="aspect-[4/5] h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
      </div>
    </div>
  </div>

  <div class="wrap mt-20">
    <dl class="grid grid-cols-2 border-t border-line lg:grid-cols-4">
      {a.stats.map((s, i) => (
        <div class:list={['border-b border-line py-8 pe-6 lg:border-b-0', i % 2 === 1 && 'border-s ps-6', i >= 1 && 'lg:border-s lg:ps-8']} data-reveal style={`--d:${i}`}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="display block text-6xl leading-none tnum sm:text-7xl"><bdi dir="ltr">{s.value}</bdi></span>
            <span class="mt-3 block text-sm text-fg-2">{s.label}</span>
            {s.note && <span class="mt-1 block text-xs text-muted">{s.note}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
