---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import Picture from '../Picture.astro';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const a = c.about;
---

<section id="about" class="section relative isolate overflow-hidden" aria-labelledby="about-title">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="relative lg:col-span-5" data-reveal>
      <div class="relative lg:sticky lg:top-28">
        <div class="zoom relative overflow-hidden rounded-[var(--radius-lg)] border border-line bg-ink-3">
          <Picture
            image="portrait"
            alt={a.portraitAlt}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 28rem, 92vw"
            width={800}
            height={1000}
            class="aspect-[4/5] h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 lg:ps-6">
      <SectionHead kicker={a.kicker} headline={a.headline} accent={2} id="about-title" />
      <p class="mt-10 max-w-2xl text-xl leading-relaxed text-fg sm:text-[1.375rem]" data-reveal>{a.intro}</p>
      <div class="mt-6 grid max-w-2xl gap-5">
        {a.paragraphs.map((p, i) => <p class="lede" data-reveal style={`--d:${i + 1}`}>{p}</p>)}
      </div>

      <blockquote class="mt-12 max-w-2xl border-s-2 border-violet ps-6" data-reveal>
        <p class="display text-[clamp(1.6rem,2.6vw,2.25rem)] leading-[1.15] text-fg">“{a.quote}”</p>
        <footer class="meta mt-4">{c.name}</footer>
      </blockquote>

      <ul class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line sm:grid-cols-3">
        {a.principles.map((p, i) => (
          <li class="bg-ink p-6">
            <div data-reveal style={`--d:${i}`}>
              <span class="text-xs text-violet-2 tnum"><bdi dir="ltr">{String(i + 1).padStart(2, '0')}</bdi></span>
              <h3 class="mt-4 text-base font-medium text-fg">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <a href="#career" class="link-arrow mt-10" data-reveal>
        {a.more}
        <svg class="flip-rtl" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</section>
