---
import type { Lang } from '../../data/types';
import { SITE } from '../../data/site';
import { getContent, href } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const en = getContent('en');
const k = c.contact;
const f = k.form;

// Submitted option values stay in English so both locales produce comparable Netlify submissions.
const collaboration = f.collaborationOptions.map((label, i) => ({ label, value: en.contact.form.collaborationOptions[i] }));

const paths = [
  { key: 'executive', form: SITE.forms.executive, ...k.paths.executive },
  { key: 'partnership', form: SITE.forms.partnership, ...k.paths.partnership },
] as const;

const direct = [
  { label: k.email, value: SITE.email, href: `mailto:${SITE.email}`, ltr: true },
  { label: k.whatsapp, value: SITE.whatsappDisplay, href: SITE.whatsappUrl, ltr: true, external: true },
  { label: k.linkedin, value: 'linkedin.com/in/mostafasofy', href: SITE.linkedin, ltr: true, external: true },
  { label: k.profile, value: k.profileCta, href: SITE.profilePdf, download: true },
];
const opt = `<span class="text-muted font-normal">(${f.optional})</span>`;
---

<section id="contact" class="section relative isolate overflow-hidden" aria-labelledby="contact-title">
  <div class="glow -bottom-72 left-1/2 -z-10 h-[44rem] w-[64rem] -translate-x-1/2 opacity-60"></div>
  <div class="wrap">
    <SectionHead kicker={k.kicker} headline={k.headline} accent={2} sub={k.sub} id="contact-title" />

    <div class="mt-14 grid gap-8 lg:grid-cols-12">
      <!-- Path selector -->
      <div class="lg:col-span-4" data-reveal>
        <div class="tabs grid gap-3" role="tablist" aria-label={k.kicker}>
          {paths.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.key}`}
              aria-controls={`panel-${p.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              <span class="meta text-violet-2">{p.audience}</span>
              <span class="mt-2 block text-lg font-medium text-fg">{p.title}</span>
              <span class="mt-1.5 block text-sm leading-relaxed text-muted">{p.body}</span>
            </button>
          ))}
        </div>

        <div class="mt-10">
          <h3 class="meta">{k.direct}</h3>
          <ul class="mt-3">
            {direct.map((d) => (
              <li class="border-b border-line">
                <a
                  href={d.href}
                  target={d.external ? '_blank' : undefined}
                  rel={d.external ? 'noopener' : undefined}
                  download={d.download ? '' : undefined}
                  class="group flex items-center justify-between gap-4 py-3.5"
                >
                  <span class="text-sm text-muted">{d.label}</span>
                  <span class="flex items-center gap-2 text-sm text-fg transition-colors group-hover:text-violet-soft">
                    {d.ltr ? <bdi dir="ltr">{d.value}</bdi> : d.value}
                    <svg class="flip-rtl flex-none" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 10L10 4M10 4H5M10 4v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="meta mt-5">{c.locations}</p>
        </div>
      </div>

      <!-- Forms -->
      <div class="lg:col-span-8" data-reveal style="--d:1">
        {paths.map((p, i) => (
          <div id={`panel-${p.key}`} role="tabpanel" aria-labelledby={`tab-${p.key}`} class:list={['tabpanel surface p-6 sm:p-9', i > 0 && 'mt-6 lg:mt-0']} data-panel={p.key}>
            <form
              name={p.form}
              method="POST"
              action={href(lang, '/thank-you')}
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="netlify-form"
              novalidate
            >
              <input type="hidden" name="form-name" value={p.form} />
              <input type="hidden" name="language" value={lang} />
              <p class="hidden" aria-hidden="true">
                <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>

              <h3 class="t-h3">{p.title}</h3>
              <p class="mt-2 text-sm text-muted">{p.body}</p>

              <div class="mt-8 grid gap-5 sm:grid-cols-2">
                <div>
                  <label class="label" for={`${p.key}-name`}>{f.name}</label>
                  <input class="field" id={`${p.key}-name`} name="name" type="text" autocomplete="name" required />
                </div>
                <div>
                  <label class="label" for={`${p.key}-company`}>{f.company}</label>
                  <input class="field" id={`${p.key}-company`} name="company" type="text" autocomplete="organization" required />
                </div>
                <div>
                  <label class="label" for={`${p.key}-email`}>{f.email}</label>
                  <input class="field" id={`${p.key}-email`} name="email" type="email" autocomplete="email" dir="ltr" required />
                </div>
                {p.key === 'executive' ? (
                  <div>
                    <label class="label" for="executive-position">{f.position}</label>
                    <input class="field" id="executive-position" name="position" type="text" required />
                  </div>
                ) : (
                  <div>
                    <label class="label" for="partnership-collaboration">{f.collaboration}</label>
                    <select class="field" id="partnership-collaboration" name="collaboration" required>
                      <option value="">{f.collaborationPlaceholder}</option>
                      {collaboration.map((o) => <option value={o.value}>{o.label}</option>)}
                    </select>
                  </div>
                )}
                <div class="sm:col-span-2">
                  <label class="label" for={`${p.key}-message`}>{f.message} <Fragment set:html={opt} /></label>
                  <textarea class="field" id={`${p.key}-message`} name="message" rows="4"></textarea>
                </div>
              </div>

              <p class="form-error mt-5 hidden rounded-[8px] border border-[#ff8a8a]/40 bg-[#ff8a8a]/10 px-4 py-3 text-sm text-[#ffc2c2]" role="alert"></p>

              <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
                <button type="submit" class="btn btn-primary" data-sending={f.sending}>
                  {p.cta}
                  <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
            </form>

            <div class="form-success hidden py-12 text-center" role="status" tabindex="-1">
              <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-violet/15 text-violet-2" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <p class="display mt-6 text-4xl">{f.successTitle}</p>
              <p class="mx-auto mt-3 max-w-md text-fg-2">{f.successBody}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <div id="faq" class="mt-24 grid gap-10 border-t border-line pt-14 lg:grid-cols-12">
      <h3 class="h-section !text-[clamp(1.9rem,3.2vw,2.75rem)] lg:col-span-4" data-reveal>{k.faqTitle}</h3>
      <div class="lg:col-span-8">
        {k.faq.map((item, i) => (
          <details class="group border-b border-line first:border-t" data-reveal>
            <summary class="flex items-start justify-between gap-6 py-5">
              <span class="flex gap-4">
                <span class="pt-1 text-xs text-muted tnum"><bdi dir="ltr">{String(i + 1).padStart(2, '0')}</bdi></span>
                <span class="text-lg font-medium text-fg transition-colors group-hover:text-violet-soft">{item.q}</span>
              </span>
              <span class="plus mt-0.5 grid h-8 w-8 flex-none place-items-center rounded-[8px] border border-line-2" aria-hidden="true">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-6 ps-8 text-[0.9375rem] leading-relaxed text-fg-2">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ requiredMsg: f.required, errorMsg: f.error }}>
  // Tabs: switch between the two inquiry paths (both stay visible without JS)
  const tabs = [...document.querySelectorAll('#contact [role="tab"]')];
  const panels = [...document.querySelectorAll('#contact [role="tabpanel"]')];
  const select = (tab, focus) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => (p.hidden = p.id !== tab.getAttribute('aria-controls')));
    if (focus) tab.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t, false));
    t.addEventListener('keydown', (e) => {
      const keys = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      const rtl = document.dir === 'rtl' && (e.key === 'ArrowRight' || e.key === 'ArrowLeft');
      const step = keys[e.key] * (rtl ? -1 : 1);
      select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  });
  if (tabs.length) select(tabs[0], false);
  // Allow deep links such as #contact-partnership
  const deep = location.hash.match(/^#contact-(executive|partnership)$/);
  if (deep) select(document.getElementById(`tab-${deep[1]}`), false);

  // Forms: validate, submit to Netlify via fetch, one submission at a time
  document.querySelectorAll('form.netlify-form').forEach((form) => {
    const panel = form.parentElement;
    const err = form.querySelector('.form-error');
    const btn = form.querySelector('button[type="submit"]');
    const success = panel.querySelector('.form-success');
    let busy = false;

    form.querySelectorAll('.field').forEach((el) =>
      el.addEventListener('input', () => el.checkValidity() && el.removeAttribute('aria-invalid')),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const invalid = [...form.querySelectorAll('.field')].filter((el) => !el.checkValidity());
      form.querySelectorAll('.field').forEach((el) => el.removeAttribute('aria-invalid'));
      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        err.textContent = requiredMsg;
        err.classList.remove('hidden');
        invalid[0].focus();
        return;
      }
      busy = true;
      err.classList.add('hidden');
      const label = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = btn.dataset.sending + '…';
      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
      } catch {
        err.textContent = errorMsg;
        err.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = label;
        busy = false;
      }
    });
  });
</script>
