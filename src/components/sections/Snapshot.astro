---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const s = c.snapshot;
---

<section aria-label={s.label} class="border-y border-line bg-ink-2">
  <div class="wrap">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {s.stats.map((st, i) => (
        <div class:list={['py-9 pe-5 sm:py-11', i % 2 === 1 && 'border-s border-line ps-5 sm:ps-8', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:border-s lg:ps-8']} data-reveal style={`--d:${i}`}>
          <dt class="sr-only">{st.label}</dt>
          <dd>
            <span class:list={['display fig block whitespace-nowrap leading-none tnum', st.value.length > 6 ? 'text-[clamp(1.55rem,6vw,3.75rem)]' : 'text-[clamp(2.25rem,6vw,3.75rem)]']}><bdi dir="ltr">{st.value}</bdi></span>
            <span class="mt-3 block text-sm text-fg">{st.label}</span>
            {st.note && <span class="mt-1 block text-xs leading-relaxed text-muted">{st.note}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
