---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const k = c.clients;
---

<section id="clients" class="border-t border-line py-20 sm:py-28" aria-labelledby="clients-title">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="clients-title" class="kicker" data-reveal><span class="num">06</span><span>{k.headline}</span></h2>
      <p class="text-sm text-muted" data-reveal>{k.note}</p>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line sm:grid-cols-3 lg:grid-cols-6">
      {k.names.map((n, i) => (
        <li class="grid min-h-28 place-items-center bg-ink px-4 text-center">
          <span class="display text-xl leading-tight text-fg-2 transition-colors duration-300 hover:text-fg sm:text-2xl" dir="ltr" data-reveal style={`--d:${i % 6}`}>{n}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
