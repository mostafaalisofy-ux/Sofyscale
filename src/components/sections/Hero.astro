---
import type { Lang } from '../../data/types';
import { getContent, href } from '../../i18n';
import Picture from '../Picture.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.hero;
---

<section class="relative isolate overflow-hidden pt-28 sm:pt-32 lg:min-h-[100svh] lg:pt-36" aria-labelledby="hero-title">
  <div class="glow -top-40 start-[-10%] -z-10 h-[38rem] w-[38rem] opacity-70"></div>
  <div class="glow end-[-15%] top-1/3 -z-10 h-[30rem] w-[30rem] opacity-40"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(255_255_255/0.035)_1px,transparent_1px)] bg-[size:calc(100%/6)_100%] [mask-image:linear-gradient(to_bottom,#000,transparent_85%)]"></div>

  <div class="wrap grid items-end gap-12 pb-16 lg:grid-cols-12 lg:gap-10 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="chip rise-fade">
        <span class="pulse h-1.5 w-1.5 rounded-full bg-violet-soft" aria-hidden="true"></span>
        {h.eyebrow}
      </p>

      <h1 id="hero-title" class="rise mt-8">
        <span class="sr-only">{c.name}, </span>
        <span class="brand block leading-[0.82] tracking-[-0.045em] text-[clamp(6.5rem,24vw,17.5rem)]"><bdi dir="ltr">Sofy<span class="text-violet-soft">.</span></bdi></span>
        <span class="mt-10 block text-[clamp(1.6rem,3.4vw,2.75rem)] leading-[1.1] text-fg-2 display rtl:leading-[1.45]">{h.sub}</span>
      </h1>

      <p class="lede rise-fade mt-6 max-w-xl" style="--d:2">{h.body}</p>

      <div class="rise-fade mt-10 flex flex-wrap gap-3" style="--d:3">
        <a href="#book" class="btn btn-primary">
          {c.ctaPrimary}
          <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href={href(lang, '/case-studies')} class="btn btn-ghost">{c.ctaSecondary}</a>
      </div>

      <dl class="rise-fade mt-14 grid max-w-xl grid-cols-3 border-t border-line pt-6" style="--d:4">
        {h.chips.map((s, i) => (
          <div class:list={['pe-4', i > 0 && 'border-s border-line ps-4 sm:ps-6']}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="display block whitespace-nowrap text-[clamp(1.5rem,6.2vw,2.75rem)] leading-none tnum"><bdi dir="ltr">{s.value}</bdi></span>
              <span class="mt-2 block text-xs leading-snug text-muted sm:text-sm">{s.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="rise relative lg:col-span-5" style="--d:1">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-[1.75rem] border border-line bg-ink-3 lg:max-w-none">
        <Picture
          image="hero"
          alt={h.portraitAlt}
          sizes="(min-width: 1024px) 38vw, (min-width: 640px) 28rem, 92vw"
          width={1200}
          height={1500}
          class="h-full w-full object-cover object-top"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"></div>
        <div class="absolute inset-0 mix-blend-soft-light bg-[radial-gradient(120%_80%_at_80%_0%,rgb(124_58_237/0.45),transparent_60%)]"></div>
      </div>
      <ul class="absolute inset-x-4 bottom-4 grid grid-cols-2 gap-3 sm:inset-x-6 sm:bottom-6">
        {h.badges.map((b) => (
          <li class="rounded-2xl border border-white/10 bg-ink/70 px-4 py-3 backdrop-blur-md">
            <span class="block text-lg font-medium leading-tight"><bdi dir="ltr">{b.value}</bdi></span>
            <span class="mt-0.5 block text-xs text-muted">{b.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
