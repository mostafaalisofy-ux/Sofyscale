---
import type { Lang } from '../../data/types';
import { SITE } from '../../data/site';
import { getContent } from '../../i18n';
import Picture from '../Picture.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.hero;
---

<section id="top" class="relative isolate overflow-hidden pt-28 sm:pt-32 lg:min-h-[100svh] lg:pt-0" aria-labelledby="hero-title">
  <div class="grid-lines -z-10"></div>
  <div class="glow -top-48 start-[-12%] -z-10 h-[34rem] w-[34rem] opacity-60"></div>

  <div class="wrap grid items-center gap-10 lg:min-h-[100svh] lg:grid-cols-12 lg:gap-8 lg:pt-24">
    <div class="relative z-10 lg:col-span-7 lg:pb-16">
      <p class="eyebrow rise-fade flex-wrap !gap-x-3 !gap-y-1 text-muted max-sm:!text-[0.65rem] max-sm:!tracking-[0.14em]">
        {h.roles.map((r, i) => (
          <>
            {i > 0 && <span class="text-violet-2/70" aria-hidden="true">/</span>}
            <span class="whitespace-nowrap">{r}</span>
          </>
        ))}
      </p>

      <h1 id="hero-title" class="rise t-display-xl mt-7">
        <span class="block">{h.title[0]}</span>
        <span class="accent-grad block">{h.title[1]}</span>
      </h1>

      <p class="lede rise-fade mt-7 max-w-xl text-[clamp(1.125rem,1.5vw,1.3rem)]" style="--d:2">{h.sub}</p>

      <div class="rise-fade mt-10 flex flex-wrap gap-3" style="--d:3">
        <a href="#career" class="btn btn-primary">
          {h.ctaExplore}
          <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="#contact" class="btn btn-ghost">{h.ctaDiscuss}</a>
      </div>

      <div class="rise-fade mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6 text-sm" style="--d:4">
        <span class="inline-flex items-center gap-2.5 text-fg">
          <span class="pulse h-1.5 w-1.5 rounded-full bg-violet-2" aria-hidden="true"></span>
          <bdi>{h.current}</bdi>
        </span>
        <a href={SITE.profilePdf} download class="link-arrow">
          {c.nav.profile} (PDF)
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    <div class="rise relative lg:col-span-5 lg:self-end" style="--d:1">
      <div class="glow inset-x-[10%] top-[18%] -z-10 h-[70%] opacity-90"></div>
      <div class="portrait relative mx-auto aspect-[4/5] w-full max-w-md lg:max-w-none">
        <Picture
          image="hero"
          alt={h.portraitAlt}
          sizes="(min-width: 1024px) 38vw, (min-width: 640px) 28rem, 92vw"
          width={1120}
          height={1400}
          class="h-full w-full object-cover object-top"
          priority
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Blend the studio portrait into the page: fade the bottom and outer edges */
  .portrait {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 62%, transparent 98%), linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 62%, transparent 98%), linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%);
    mask-composite: intersect;
  }
</style>
