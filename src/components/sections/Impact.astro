---
import type { Lang } from '../../data/types';
import { getContent, href } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const m = c.impact;
const icons = [
  'M3 17V9m6 8V5m6 12v-6m6 6V3', // business development: rising bars
  'M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1M12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z', // operations: gear-like
  'M4 7l8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4', // transformation: layers
  'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-1A3.5 3.5 0 0 0 8 17.5V19m4-8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6 1.5a2.5 2.5 0 1 0 0-5M21 19v-1a3 3 0 0 0-2-2.8M6 12.5a2.5 2.5 0 1 1 0-5M3 19v-1a3 3 0 0 1 2-2.8', // team
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z', // market: globe
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-4a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-4a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z', // performance: target
];
---

<section id="impact" class="section relative isolate overflow-hidden" aria-labelledby="impact-title">
  <div class="glow start-[-15%] bottom-0 -z-10 h-[30rem] w-[30rem] opacity-40"></div>
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <SectionHead kicker={m.kicker} headline={m.headline} accent={2} id="impact-title" class="lg:col-span-7" />
      <p class="lede lg:col-span-5" data-reveal style="--d:2">{m.sub}</p>
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
      {m.items.map((it, i) => (
        <li class="group bg-ink p-7 transition-colors duration-300 hover:bg-ink-2 sm:p-8">
          <div data-reveal style={`--d:${i % 3}`}>
            <svg class="text-violet-2" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={icons[i]} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3 class="mt-6 text-lg font-medium text-fg">{it.title}</h3>
            <p class="meta mt-5">{m.contributionLabel}</p>
            <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-fg-2">{it.contribution}</p>
            <p class="meta mt-5">{m.roleLabel}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{it.role}</p>
            {i === m.items.length - 1 && (
              <a href={href(lang, '/case-studies')} class="link-arrow mt-5">
                {c.casesTeaser.viewAll}
                <svg class="flip-rtl" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted" data-reveal>{m.note}</p>

    <div class="mt-20" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-4">
        <h3 class="meta">{m.clientsTitle}</h3>
        <p class="text-xs text-muted">{m.clientsNote}</p>
      </div>
      <ul class="mt-2 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
        {m.clients.map((n) => (
          <li class="flex min-h-20 items-center border-b border-line px-1 py-4">
            <span class="display text-xl leading-tight text-fg-2 transition-colors duration-300 hover:text-fg" dir="ltr">{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
