---
import type { Lang } from '../../data/types';
import { SITE } from '../../data/site';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const k = c.career;
---

<section id="career" class="section" aria-labelledby="career-title">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <SectionHead kicker={k.kicker} headline={k.headline} accent={2} sub={k.sub} id="career-title" />
        <a href={SITE.profilePdf} download class="btn btn-ghost mt-10" data-reveal style="--d:3">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {k.profileCta}
        </a>
      </div>
    </div>

    <ol class="timeline lg:col-span-7">
      {k.items.map((item) => (
        <li class="group relative pb-7 ps-10 last:pb-0" data-reveal>
          <span class:list={['timeline-dot', item.current && 'is-current']} aria-hidden="true"></span>
          <p class="meta flex flex-wrap items-center gap-x-3 gap-y-1">
            {item.to ? (
              <bdi dir="ltr" class="tnum">{item.from} – {item.to}</bdi>
            ) : lang === 'ar' ? (
              <span class="text-violet-2">{k.presentLabel} <bdi dir="ltr" class="tnum">{item.from}</bdi></span>
            ) : (
              <span class="text-violet-2"><bdi dir="ltr" class="tnum">{item.from}</bdi> – {k.presentLabel}</span>
            )}
            <span aria-hidden="true">·</span>
            <span>{item.market}</span>
          </p>
          <div class:list={['mt-2.5 rounded-[var(--radius)] border px-5 py-4 transition-colors duration-300 sm:px-6', item.current ? 'border-violet-line bg-violet/[0.06]' : 'border-line bg-ink-3/40 group-hover:border-line-2']}>
            <h3 class="t-h3 flex flex-wrap items-center gap-3 !text-[clamp(1.4rem,2vw,1.75rem)]">
              {item.role}
              {item.current && <span class="tag tag-violet font-sans text-[0.6875rem] tracking-normal">{k.currentLabel}</span>}
            </h3>
            <p class="mt-1.5 text-[0.9375rem] text-fg"><bdi class="font-medium">{item.company}</bdi>{item.desc && <span class="text-muted"> · {item.desc}</span>}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
