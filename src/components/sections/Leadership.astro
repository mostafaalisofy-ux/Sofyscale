---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const l = c.leadership;
---

<section id="leadership" class="section section-alt relative isolate overflow-hidden border-y border-line" aria-labelledby="leadership-title">
  <div class="glow end-[-18%] top-[-10%] -z-10 h-[36rem] w-[36rem] opacity-40"></div>
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <SectionHead kicker={l.kicker} headline={l.headline} accent={2} id="leadership-title" class="lg:col-span-7" />
      <p class="lede lg:col-span-5" data-reveal style="--d:2">{l.sub}</p>
    </div>

    <ol class="mt-16 border-t border-line">
      {l.pillars.map((p, i) => (
        <li class="group grid gap-6 border-b border-line py-9 transition-colors duration-300 hover:bg-white/[0.012] lg:grid-cols-12 lg:gap-10" data-reveal>
          <div class="flex items-baseline gap-5 lg:col-span-5">
            <span class="fig display text-2xl text-violet-2 tnum"><bdi dir="ltr">{String(i + 1).padStart(2, '0')}</bdi></span>
            <div>
              <h3 class="t-h3 transition-colors duration-300 group-hover:text-violet-soft">{p.title}</h3>
              <p class="mt-3 max-w-sm text-[0.9375rem] leading-relaxed text-fg-2">{p.summary}</p>
            </div>
          </div>
          <ul class="grid content-start gap-x-8 gap-y-3 ps-12 sm:grid-cols-2 lg:col-span-7 lg:ps-0 lg:pt-2">
            {p.points.map((pt) => (
              <li class="flex items-start gap-3 text-[0.9375rem] text-fg-2">
                <span class="mt-[0.6rem] h-px w-3 flex-none bg-violet-2" aria-hidden="true"></span>
                {pt}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="mt-16" data-reveal>
      <h3 class="meta">{l.stackTitle}</h3>
      <dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {l.stack.map((g) => (
          <div class="border-t border-line pt-4">
            <dt class="text-sm font-medium text-fg">{g.name}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{g.tools.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
