---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';
import IntakeForm from '../IntakeForm.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const s = c.sessions;
---

<section id="book" class="section relative isolate overflow-hidden border-t border-line" aria-labelledby="book-title">
  <div class="glow left-1/2 top-24 -z-10 h-[44rem] w-[44rem] -translate-x-1/2 opacity-50"></div>
  <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <SectionHead num="10" kicker={s.kicker} headline={s.headline} accent={3} sub={s.intro} id="book-title" />

      <h3 class="mt-12 text-xs uppercase tracking-[0.18em] text-muted" data-reveal>{s.topicsLabel}</h3>
      <ul class="mt-4 grid gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {s.topics.map((tp) => (
          <li class="bg-ink p-5">
            <p class="font-medium">{tp.title}</p>
            <p class="mt-1 text-sm text-muted">{tp.body}</p>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex gap-4 rounded-[1.25rem] border border-violet-2/30 bg-violet/[0.06] p-5" data-reveal>
        <span class="pulse mt-1.5 h-2 w-2 flex-none rounded-full bg-violet-soft" aria-hidden="true"></span>
        <div>
          <p class="text-sm font-medium text-violet-soft">{s.scarcityTag}</p>
          <p class="mt-1 text-sm leading-relaxed text-fg-2">{s.scarcity}</p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal style="--d:1">
      <IntakeForm lang={lang} />
    </div>
  </div>
</section>
