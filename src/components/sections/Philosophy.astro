---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const p = c.philosophy;
const icons = [
  'M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Zm0-9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-1A3.5 3.5 0 0 0 8 17.5V19m4-8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6 1.5a2.5 2.5 0 1 0 0-5M21 19v-1a3 3 0 0 0-2-2.8M6 12.5a2.5 2.5 0 1 1 0-5M3 19v-1a3 3 0 0 1 2-2.8',
  'M4 7l8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 17l8 4 8-4',
];
---

<section id="philosophy" class="section relative isolate overflow-hidden" aria-labelledby="philosophy-title">
  <div class="grid-lines -z-10"></div>
  <div class="glow end-[-10%] top-[10%] -z-10 h-[40rem] w-[40rem] opacity-50"></div>
  <div class="wrap">
    <p class="kicker" data-reveal>{p.kicker}</p>
    <h2 id="philosophy-title" class="mt-8 t-display-xl !text-[clamp(2.6rem,6.4vw,6.25rem)]" data-reveal style="--d:1">
      <span class="block text-fg-2">{p.lines[0]}</span>
      <span class="block text-fg-2">{p.lines[1]}</span>
      <span class="block">
        {p.lines[2].split(' ').slice(0, -1).join(' ')} <span class="accent-grad">{p.lines[2].split(' ').slice(-1)}</span>
      </span>
    </h2>

    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <p class="lede text-fg lg:col-span-5" data-reveal>{p.statement}</p>
      <ul class="grid gap-8 sm:grid-cols-3 lg:col-span-7 lg:col-start-6">
        {p.pillars.map((pl, i) => (
          <li class="border-t border-violet-line pt-5" data-reveal style={`--d:${i}`}>
            <svg class="text-violet-2" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={icons[i]} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <h3 class="mt-4 font-medium text-fg">{pl.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{pl.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
