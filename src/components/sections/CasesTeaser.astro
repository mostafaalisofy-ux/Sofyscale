---
import type { Lang } from '../../data/types';
import { CASES, FEATURED } from '../../data/cases';
import { getContent, href } from '../../i18n';
import SectionHead from '../SectionHead.astro';
import CaseCard from '../CaseCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const k = c.casesTeaser;
const items = FEATURED.map((n) => CASES.find((x) => x.num === n)!).filter(Boolean);
---

<section id="case-studies" class="section border-t border-line" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead num="09" kicker={k.kicker} headline={k.headline} accent={2} sub={k.sub} id="cases-title" />
      <a href={href(lang, '/case-studies')} class="btn btn-ghost shrink-0" data-reveal>
        {k.viewAll}
        <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <li data-reveal style={`--d:${i % 3}`}><CaseCard item={item} lang={lang} /></li>
      ))}
    </ul>
  </div>
</section>
