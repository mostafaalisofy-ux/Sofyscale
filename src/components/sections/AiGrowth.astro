---
import type { Lang } from '../../data/types';
import { getContent } from '../../i18n';
import SectionHead from '../SectionHead.astro';

interface Props { lang: Lang }
const c = getContent(Astro.props.lang);
const ai = c.ai;
---

<section id="ai" class="section relative isolate overflow-hidden border-t border-line" aria-labelledby="ai-title">
  <div class="glow end-[-20%] top-0 -z-10 h-[40rem] w-[40rem] opacity-40"></div>
  <div class="wrap">
    <SectionHead num="03" kicker={ai.kicker} headline={ai.headline} accent={4} sub={ai.intro} id="ai-title" />

    <ol class="mt-20 grid gap-4">
      {ai.items.map((item) => (
        <li class="card overflow-hidden" data-reveal>
          <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <p class="flex items-center gap-3 text-xs uppercase tracking-[0.18em] text-muted">
                <span class="display text-5xl normal-case tracking-normal text-violet-soft tnum"><bdi dir="ltr">{item.num}</bdi></span>
                <span class="rounded-full border border-line-2 px-2.5 py-1">{item.type}</span>
              </p>
              <h3 class="display mt-6 text-3xl leading-[1.05] sm:text-4xl">{item.title}</h3>
            </div>
            <dl class="grid gap-6 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-3">
              <div>
                <dt class="text-xs uppercase tracking-[0.16em] text-muted">{ai.labels.problem}</dt>
                <dd class="mt-3 text-[0.9375rem] leading-relaxed text-fg-2">{item.problem}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-[0.16em] text-violet-soft">{ai.labels.outcome}</dt>
                <dd class="mt-3 text-[0.9375rem] leading-relaxed text-fg">{item.outcome}</dd>
              </div>
              <div class="sm:col-span-2 lg:col-span-1">
                <dt class="text-xs uppercase tracking-[0.16em] text-muted">{ai.labels.detail}</dt>
                <dd class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.detail}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))}
    </ol>

    <p class="display mx-auto mt-20 max-w-4xl text-center text-[clamp(1.6rem,3.2vw,2.6rem)] leading-[1.2] text-fg-2" data-reveal>
      {ai.closing}
    </p>
  </div>
</section>
