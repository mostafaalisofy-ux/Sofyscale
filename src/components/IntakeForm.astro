---
import type { Lang } from '../data/types';
import { SITE } from '../data/site';
import { getContent, href } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const en = getContent('en');
const f = c.form;
const total = 3;

// Submitted values are always English so Netlify submissions read the same from both locales.
const business = f.businessOptions.map((label, i) => ({ label, value: en.form.businessOptions[i] }));
const markets = f.marketOptions.map((label, i) => ({ label, value: en.form.marketOptions[i] }));
const challenges = c.sessions.topics.map((tp, i) => ({ label: tp.title, value: en.sessions.topics[i].title }));
const id = (s: string) => `f-${s}`;
---

<div class="card relative overflow-hidden p-6 sm:p-10">
  <form
    name={SITE.formName}
    method="POST"
    action={href(lang, '/thank-you')}
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="intake"
    novalidate
    data-step-label={f.stepOf(1, total)}
  >
    <input type="hidden" name="form-name" value={SITE.formName} />
    <input type="hidden" name="language" value={lang} />
    <p class="hidden" aria-hidden="true">
      <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="flex items-center justify-between gap-4">
      <h3 class="display text-2xl sm:text-3xl">{f.title}</h3>
      <p class="step-count shrink-0 text-xs text-muted tnum" aria-live="polite">{f.stepOf(1, total)}</p>
    </div>
    <div class="mt-5 grid grid-cols-3 gap-1.5" aria-hidden="true">
      {[1, 2, 3].map((n) => <span class="progress h-0.5 rounded-full bg-line-2 transition-colors duration-500" data-n={n}></span>)}
    </div>

    <!-- Step 1 -->
    <fieldset class="step mt-10" data-step="1">
      <legend class="text-xs uppercase tracking-[0.18em] text-violet-soft">{f.steps[0]}</legend>

      <fieldset class="mt-6">
        <legend class="text-lg font-medium">{f.businessQ}</legend>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          {business.map((o) => (
            <label class="option"><input type="radio" name="business_type" value={o.value} required /><span class="tick" aria-hidden="true"></span>{o.label}</label>
          ))}
        </div>
      </fieldset>

      <fieldset class="mt-8">
        <legend class="text-lg font-medium">{f.marketQ}</legend>
        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {markets.map((o) => (
            <label class="option"><input type="radio" name="market" value={o.value} required /><span class="tick" aria-hidden="true"></span>{o.label}</label>
          ))}
        </div>
      </fieldset>
    </fieldset>

    <!-- Step 2 -->
    <fieldset class="step mt-10" data-step="2">
      <legend class="text-xs uppercase tracking-[0.18em] text-violet-soft">{f.steps[1]}</legend>
      <fieldset class="mt-6">
        <legend class="text-lg font-medium">{f.challengeQ}</legend>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          {challenges.map((o) => (
            <label class="option"><input type="radio" name="challenge" value={o.value} required /><span class="tick" aria-hidden="true"></span>{o.label}</label>
          ))}
        </div>
      </fieldset>
      <div class="mt-8">
        <label for={id('budget')} class="text-lg font-medium">{f.budgetQ}</label>
        <input id={id('budget')} name="budget" type="text" class="field" autocomplete="off" />
      </div>
    </fieldset>

    <!-- Step 3 -->
    <fieldset class="step mt-10" data-step="3">
      <legend class="text-xs uppercase tracking-[0.18em] text-violet-soft">{f.steps[2]}</legend>
      <div class="mt-4 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        <div>
          <label for={id('name')} class="text-sm text-fg-2">{f.name}</label>
          <input id={id('name')} name="name" type="text" class="field" autocomplete="name" required />
        </div>
        <div>
          <label for={id('email')} class="text-sm text-fg-2">{f.email}</label>
          <input id={id('email')} name="email" type="email" class="field" autocomplete="email" dir="ltr" required />
        </div>
        <div>
          <label for={id('whatsapp')} class="text-sm text-fg-2">{f.whatsapp}</label>
          <input id={id('whatsapp')} name="whatsapp" type="tel" class="field" autocomplete="tel" inputmode="tel" dir="ltr" />
        </div>
        <div>
          <label for={id('company')} class="text-sm text-fg-2">{f.company}</label>
          <input id={id('company')} name="company" type="text" class="field" autocomplete="organization" />
        </div>
        <div class="sm:col-span-2">
          <label for={id('message')} class="text-sm text-fg-2">{f.message}</label>
          <textarea id={id('message')} name="message" rows="3" class="field resize-y"></textarea>
        </div>
      </div>
    </fieldset>

    <p class="form-error mt-6 hidden text-sm text-[#ffb4b4]" role="alert"></p>

    <div class="mt-10 flex items-center justify-between gap-3">
      <button type="button" class="btn btn-ghost back hidden">{f.back}</button>
      <span class="spacer"></span>
      <button type="button" class="btn btn-primary next hidden">
        {f.next}
        <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="submit" class="btn btn-primary submit" data-sending={f.sending}>{f.submit}</button>
    </div>
  </form>

  <div class="success hidden py-10 text-center" role="status" tabindex="-1">
    <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-violet/15 text-violet-soft" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <p class="display mt-6 text-4xl">{f.successTitle}</p>
    <p class="mx-auto mt-3 max-w-md text-fg-2">{f.successBody}</p>
  </div>
</div>

<script define:vars={{ stepTpl: [f.stepOf(1, 3), f.stepOf(2, 3), f.stepOf(3, 3)], requiredMsg: f.required, errorMsg: f.error }}>
  const form = document.querySelector('form.intake');
  if (form) {
    const steps = [...form.querySelectorAll('.step')];
    const back = form.querySelector('.back');
    const next = form.querySelector('.next');
    const submit = form.querySelector('.submit');
    const count = form.querySelector('.step-count');
    const bars = [...form.querySelectorAll('.progress')];
    const err = form.querySelector('.form-error');
    const success = form.parentElement.querySelector('.success');
    let current = 0;

    const show = (i, focus) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      back.classList.toggle('hidden', i === 0);
      next.classList.toggle('hidden', i === steps.length - 1);
      submit.classList.toggle('hidden', i !== steps.length - 1);
      count.textContent = stepTpl[i];
      bars.forEach((b, n) => b.classList.toggle('!bg-violet-soft', n <= i));
      err.classList.add('hidden');
      if (focus) steps[i].querySelector('input, textarea')?.focus({ preventScroll: true });
    };

    const valid = (i) => {
      const fields = [...steps[i].querySelectorAll('input, textarea')];
      const bad = fields.find((el) => !el.checkValidity());
      if (bad) {
        err.textContent = requiredMsg;
        err.classList.remove('hidden');
        bad.focus();
        return false;
      }
      return true;
    };

    next.addEventListener('click', () => valid(current) && show(current + 1, true));
    back.addEventListener('click', () => show(current - 1, true));
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.tagName === 'INPUT' && current < steps.length - 1) {
        e.preventDefault();
        if (valid(current)) show(current + 1, true);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      for (let i = 0; i < steps.length; i++) {
        if (!valid(i)) { show(i, false); valid(i); return; }
      }
      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = submit.dataset.sending + '…';
      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
      } catch {
        err.textContent = errorMsg;
        err.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = label;
      }
    });

    show(0, false);
  }
</script>
