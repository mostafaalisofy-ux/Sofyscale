---
import type { Lang } from '../data/types';
import { type CaseStudy, t } from '../data/cases';
import { getContent, href } from '../i18n';
import CaseCover from './CaseCover.astro';

interface Props { item: CaseStudy; lang: Lang; headingLevel?: 'h2' | 'h3'; size?: 'lg' | 'md' }
const { item, lang, headingLevel: H = 'h3', size = 'md' } = Astro.props;
const c = getContent(lang);
---

<article
  class="case-card group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-line bg-ink-2 transition-[border-color,transform] duration-500 hover:-translate-y-1 hover:border-violet-line"
  data-market={item.markets.join(' ')}
  data-discipline={item.disciplines.join(' ')}
  data-industry={item.industries.join(' ')}
>
  <CaseCover item={item} lang={lang} class={size === 'lg' ? 'aspect-[4/3]' : 'aspect-[16/10]'} />

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="meta">{t(item.market, lang)}</p>
    <H class="mt-3 text-xl font-medium leading-snug text-fg">
      <a href={href(lang, `/case-studies/${item.slug}`)} class="after:absolute after:inset-0 after:content-['']">
        {t(item.title, lang)}
      </a>
    </H>
    <p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-2">{t(item.headline, lang)}</p>

    <div class="mt-auto pt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-4 text-xs text-muted">
        {item.metrics.map((m) => (
          <li><bdi dir="ltr" class="text-fg">{t(m.value, lang)}</bdi>{m.label && <> {t(m.label, lang)}</>}</li>
        ))}
      </ul>
      <p class="mt-5 flex items-center gap-2 text-sm font-medium text-violet-soft transition-[gap] duration-300 group-hover:gap-3" aria-hidden="true">
        {c.casesPage.read}
        <svg class="flip-rtl" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </p>
    </div>
  </div>
</article>
