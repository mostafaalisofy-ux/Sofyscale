---
import type { Lang } from '../data/types';
import { getContent, href, homeAnchor } from '../i18n';

interface Props { lang: Lang; path: string; onHome: boolean }
const { lang, path, onHome } = Astro.props;
const c = getContent(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';
const isCases = path.startsWith('/case-studies');

const links = [
  { label: c.nav.about, href: homeAnchor(lang, 'about', onHome) },
  { label: c.nav.cases, href: href(lang, '/case-studies'), current: isCases },
  { label: c.nav.career, href: homeAnchor(lang, 'career', onHome) },
  { label: c.nav.results, href: homeAnchor(lang, 'results', onHome) },
  { label: c.nav.faq, href: homeAnchor(lang, 'faq', onHome) },
  { label: c.nav.contact, href: homeAnchor(lang, 'contact', onHome) },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500" data-scrolled="false">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href={href(lang, '/')} class="brand text-[1.75rem] leading-none tracking-tight" aria-label={`${c.name}, home`} dir="ltr">
      Sofy<span class="text-violet-soft">.</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.875rem] text-fg-2">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['transition-colors hover:text-fg', l.current && 'text-fg']} aria-current={l.current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={href(other, path)}
        hreflang={other}
        lang={other}
        class="grid h-10 min-w-10 place-items-center rounded-full border border-line-2 px-3 text-sm text-fg-2 transition-colors hover:border-white/30 hover:text-fg"
        aria-label={c.ui.langSwitchLabel}
      >
        <span dir="ltr" aria-hidden="true" class="flex items-center gap-1.5">
          <span class={lang === 'en' ? 'text-fg' : 'text-muted'}>EN</span>
          <span class="text-muted/60">/</span>
          <span class={lang === 'ar' ? 'text-fg' : 'text-muted'} style="font-family: 'IBM Plex Sans Arabic', sans-serif">ع</span>
        </span>
      </a>
      <a href={homeAnchor(lang, 'book', onHome)} class="btn btn-primary hidden !min-h-10 !px-5 !py-2.5 text-sm sm:inline-flex">
        {c.ctaPrimary}
      </a>
      <button
        type="button"
        class="menu-toggle grid h-10 w-10 place-items-center rounded-full border border-line-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={c.ui.menu}
        data-open-label={c.ui.close}
        data-closed-label={c.ui.menu}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path class="l1 origin-center transition-transform duration-300" d="M2 6h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path class="l2 origin-center transition-transform duration-300" d="M2 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav hidden border-t border-line bg-ink/95 backdrop-blur-xl lg:hidden">
    <nav aria-label="Mobile" class="wrap py-6">
      <ul class="flex flex-col">
        {links.map((l) => (
          <li class="border-b border-line">
            <a href={l.href} class="display block py-4 text-3xl">{l.label}</a>
          </li>
        ))}
      </ul>
      <a href={homeAnchor(lang, 'book', onHome)} class="btn btn-primary mt-6 w-full">{c.ctaPrimary}</a>
    </nav>
  </div>
</header>

<style>
  .menu-toggle[aria-expanded='true'] .l1 { transform: translateY(3px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .l2 { transform: translateY(-3px) rotate(-45deg); }
  .mobile-nav.open { display: block; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('mobile-nav');

  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 24 || panel?.classList.contains('open')));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.openLabel : toggle.dataset.closedLabel) ?? '');
    panel.classList.toggle('open', open);
    onScroll();
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
